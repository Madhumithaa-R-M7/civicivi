# CivicConnect Backend Environment Configuration
# Copy this file to .env and replace placeholder values with your real credentials.

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration (Managed via pgAdmin or psql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=civicconnect

# Optional: Connection URI format
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/civicconnect

# JWT Authentication Secret (Use a long, random, cryptographically secure string)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# SMS Provider Configuration for Phone OTP Authentication
# Supported providers:
# - 'textbee'  : TextBee (textbee.dev) Android SMS gateway
# - 'fast2sms' : Fast2SMS for Indian 10-digit mobile numbers (via Fast2SMS Quick OTP API)
# - 'twilio'   : International / Twilio SMS gateway
# - 'mock'     : Local mock provider for automated testing and offline dev
# Note: If real provider is selected or unconfigured and credentials are missing,
# the backend will return a clear HTTP 502 configuration error instead of falsely reporting success.
SMS_PROVIDER=textbee

# TextBee Configuration (Android Gateway via textbee.dev)
# Sign up at https://textbee.dev, install the Android app, pair your device, and copy your API key
TEXTBEE_API_KEY=txb_your_actual_api_key_here
# Optional: specific device ID if you have multiple paired devices
# TEXTBEE_DEVICE_ID=

# Fast2SMS Configuration (Alternative provider for Indian numbers)
# Sign up at https://www.fast2sms.com and get your API Key from the Dev API section
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Configuration (Alternative provider)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Resend Email Configuration for Password Recovery OTPs
# Register at https://resend.com to generate your API key
RESEND_API_KEY=re_your_actual_api_key_here
RESEND_FROM_EMAIL=CivicConnect <onboarding@resend.dev>
